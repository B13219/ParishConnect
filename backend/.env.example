# Vinyrd keeps the PARISHCONNECT_ environment prefix for backward compatibility.
PARISHCONNECT_ENVIRONMENT=local
PARISHCONNECT_API_PREFIX=/api/v1
PARISHCONNECT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PARISHCONNECT_PUBLIC_BASE_URL=
PARISHCONNECT_DATABASE_URL=postgresql+psycopg://parishconnect:parishconnect@localhost:5432/parishconnect
PARISHCONNECT_AUTH_TOKEN_SECRET=local-demo-auth-secret-change-before-production
PARISHCONNECT_QR_TOKEN_SECRET=local-demo-qr-secret-change-before-production
PARISHCONNECT_PASSWORD_SALT=local-demo-password-salt-change-before-production
PARISHCONNECT_ACCESS_TOKEN_MINUTES=720
PARISHCONNECT_DEMO_PASSWORD=parishconnect

# One-time pilot bootstrap. Remove the password after the first administrator exists.
PARISHCONNECT_BOOTSTRAP_ADMIN_NAME=
PARISHCONNECT_BOOTSTRAP_ADMIN_EMAIL=
PARISHCONNECT_BOOTSTRAP_ADMIN_PASSWORD=
PARISHCONNECT_BOOTSTRAP_BRANCH_NAME=Vinyrd Pilot Church
PARISHCONNECT_BOOTSTRAP_BRANCH_LOCATION=

# SMS messaging. Keep simulate until provider credentials are ready.
PARISHCONNECT_SMS_PROVIDER=africas_talking
PARISHCONNECT_SMS_MODE=simulate
PARISHCONNECT_SMS_USERNAME=
PARISHCONNECT_SMS_API_KEY=
PARISHCONNECT_SMS_SENDER_ID=VINYRD
PARISHCONNECT_SMS_DEFAULT_COUNTRY_CODE=255
PARISHCONNECT_SMS_CALLBACK_TOKEN=
PARISHCONNECT_SMS_REQUEST_TIMEOUT_SECONDS=15
