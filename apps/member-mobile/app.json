{
  "expo": {
    "name": "VINYRD",
    "slug": "vinyrd-member",
    "scheme": "vinyrd",
    "version": "0.1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/vinyrd-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vinyrd.member",
      "buildNumber": "1",
      "icon": "./assets/vinyrd-logo.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.vinyrd.member",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/vinyrd-logo.png",
        "backgroundColor": "#171D18"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vinyrd-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#171D18"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "888318bc-8e30-490d-bf54-3651bba54efe"
      }
    },
    "owner": "vinard"
  }
}
